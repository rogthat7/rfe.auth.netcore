{
  "$schema": "https://smithery.ai/schemas/server-card.json",
  "name": "rogthat7/rfe-auth-api",
  "displayName": "rfe-auth-api MCP Server",
  "title": "rfe-auth-api MCP Server",
  "version": "1.0.0",
  "description": "ASP.NET Core 10.0 Web API",
  "homepage": "https://github.com/rogthat7/rfe.auth.netcore",
  "homepageUrl": "https://github.com/rogthat7/rfe.auth.netcore",
  "repository": "https://github.com/rogthat7/rfe.auth.netcore",
  "repositoryUrl": "https://github.com/rogthat7/rfe.auth.netcore",
  "icon": "https://rfe-auth-api.onrender.com/static/logo.png",
  "iconUrl": "https://rfe-auth-api.onrender.com/static/logo.png",
  "serverInfo": {
    "name": "rogthat7/rfe-auth-api",
    "displayName": "rfe-auth-api MCP Server",
    "title": "rfe-auth-api MCP Server",
    "version": "1.0.0",
    "description": "ASP.NET Core 10.0 Web API",
    "homepage": "https://github.com/rogthat7/rfe.auth.netcore",
    "homepageUrl": "https://github.com/rogthat7/rfe.auth.netcore",
    "repository": "https://github.com/rogthat7/rfe.auth.netcore",
    "repositoryUrl": "https://github.com/rogthat7/rfe.auth.netcore",
    "icon": "https://rfe-auth-api.onrender.com/static/logo.png",
    "iconUrl": "https://rfe-auth-api.onrender.com/static/logo.png"
  },
  "authentication": {
    "required": false
  },
  "tools": [
    {
      "name": "summarize-openapi-specs",
      "description": "Summarizes the OpenAPI spec operations for the API.",
      "annotations": {
        "title": "Summarize OpenAPI Spec",
        "readOnlyHint": true,
        "destructive": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "operationCount": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "search-openapi-operations",
      "description": "Searches OpenAPI endpoints by keyword.",
      "annotations": {
        "title": "Search Operations",
        "readOnlyHint": true,
        "destructive": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search term"
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "name": "execute-request",
      "description": "Executes an HTTP API call against the backend.",
      "annotations": {
        "title": "Execute API Request",
        "readOnlyHint": false,
        "destructive": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "description": "Operation ID"
          }
        },
        "required": [
          "operationId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  ]
}