{
  "$schema": "https://smithery.ai/schemas/server-card.json",
  "name": "rogthat7/rfe-auth-api",
  "displayName": "RFE Auth & Identity MCP Server",
  "title": "RFE Auth & Identity MCP Server",
  "version": "1.0.0",
  "description": "Comprehensive OAuth 2.1 identity provider, OpenIddict token server, and PostgreSQL user administration backend.",
  "homepage": "https://github.com/rogthat7/rfe.auth.netcore",
  "homepageUrl": "https://github.com/rogthat7/rfe.auth.netcore",
  "repository": "https://github.com/rogthat7/rfe.auth.netcore",
  "repositoryUrl": "https://github.com/rogthat7/rfe.auth.netcore",
  "icon": "https://rfe-auth-api.onrender.com/static/logo.png",
  "iconUrl": "https://rfe-auth-api.onrender.com/static/logo.png",
  "serverInfo": {
    "name": "rogthat7/rfe-auth-api",
    "displayName": "RFE Auth & Identity MCP Server",
    "title": "RFE Auth & Identity MCP Server",
    "version": "1.0.0",
    "description": "Comprehensive OAuth 2.1 identity provider, OpenIddict token server, and PostgreSQL user administration backend.",
    "homepage": "https://github.com/rogthat7/rfe.auth.netcore",
    "homepageUrl": "https://github.com/rogthat7/rfe.auth.netcore",
    "repository": "https://github.com/rogthat7/rfe.auth.netcore",
    "repositoryUrl": "https://github.com/rogthat7/rfe.auth.netcore",
    "icon": "https://rfe-auth-api.onrender.com/static/logo.png",
    "iconUrl": "https://rfe-auth-api.onrender.com/static/logo.png"
  },
  "authentication": {
    "required": true,
    "type": "apiKey",
    "headerName": "X-API-Key"
  },
  "tools": [
    {
      "name": "summarize-openapi-specs",
      "description": "Summarizes all public OpenAPI endpoints and operations for RFE Auth API.",
      "annotations": {
        "title": "Summarize OpenAPI Specification",
        "readOnlyHint": true,
        "destructive": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "description": "Human-readable summary of API routes and capabilities"
          },
          "operationCount": {
            "type": "integer",
            "description": "Total number of available OpenAPI operations"
          }
        }
      }
    },
    {
      "name": "search-openapi-operations",
      "description": "Searches OpenAPI endpoints by keyword or controller tag.",
      "annotations": {
        "title": "Search Operations",
        "readOnlyHint": true,
        "destructive": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search keyword or endpoint path"
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "matches": {
            "type": "array",
            "description": "List of matching OpenAPI endpoint operations",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "name": "execute-request",
      "description": "Executes an HTTP API call against RFE Auth backend endpoints.",
      "annotations": {
        "title": "Execute API Request",
        "readOnlyHint": false,
        "destructive": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "description": "OpenAPI Operation ID to invoke"
          },
          "parameters": {
            "type": "object",
            "description": "Parameters payload object for path, query, or body"
          }
        },
        "required": [
          "operationId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "description": "HTTP response status code"
          },
          "data": {
            "type": "object",
            "description": "Response payload data object"
          }
        }
      }
    }
  ]
}
