{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ApiInfo": {
    "apiName": "rfe.netcore.auth",
    "basePath": "/api/auth",
    "apiDocumentation": "/swagger",
    "version": "1.0"
  },
  "ConnectionStrings": {
    "DefaultConection": "Host=localhost;Port=5432;Database=rfe-auth;Username=postgres;Password=YourStrongPassword123!"
  },
  "PostgresDockerConfig": {
    "PostgresServer": "localhost",
    "PostgresPort": 5432,
    "PostgresUser": "postgres",
    "PostgresPassword": "YourStrongPassword123!",
    "PostgresDatabase": "rfe-auth"
  },
  "CommunicationServiceConfiguration": {
    "BaseUrl": "http://localhost:5010"
  },
  "JwtConfig": {
    "Secret": "b2abbb09-d581-490a-9d70-62bdeecbaa9a",
    "Issuer": "rfe.auth.service",
    "JwtKeyForEmail": "This is the key for email Confirmation"
  },
  "CustomOptions": {
    "MyOption": "My Custom Option"
  },
  "ClientAppUrl": "https://localhost:3001",
  "Kestrel": {
    "Endpoints": {
      "HttpsInlinePem": {
        "Url": "https://*:5001",
        "Certificate": {
          "Path": "/certs/localhost+2.pem",
          "KeyPath": "/certs/localhost+2-key.pem"
        }
      }
    }
  },
  "Authentication": {
    "Github": {
      "ClientId": "YOUR_GITHUB_CLIENT_ID",
      "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET"
    },
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    }
  }
}