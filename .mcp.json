{
  "mcpServers": {
    "rfe-auth-api": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@scalar/mcp-server",
        "--url",
        "https://mcp.scalar.com/mcp/44bb19e4-ddef-4014-9f6e-bdb7515fad61"
      ]
    },
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    }
  }
}